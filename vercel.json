{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/rancho",
      "destination": "/collateral/index.html"
    }
  ],
  "headers": [
    {
      "source": "/collateral/files/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://paddockgavin.com/events/pistonpoweredranch",
      "permanent": true
    },
    {
      "source": "/show",
      "destination": "https://paddockgavin.com/events/pistonpoweredranch",
      "permanent": true
    },
    {
      "source": "/show/",
      "destination": "https://paddockgavin.com/events/pistonpoweredranch",
      "permanent": true
    },
    {
      "source": "/events",
      "destination": "https://paddockgavin.com/events",
      "permanent": true
    },
    {
      "source": "/events/",
      "destination": "https://paddockgavin.com/events",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "query",
          "key": "via"
        }
      ],
      "destination": "https://pistonpoweredranch.com/$1",
      "permanent": false
    }
  ]
}
